rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(groupId);
      allow delete: if isSignedIn() && isValidId(groupId);
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(eventId);
      allow delete: if isSignedIn() && isValidId(eventId);
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(transactionId);
      allow delete: if isSignedIn() && isValidId(transactionId);
    }

    match /media/{mediaId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(mediaId);
      allow delete: if isSignedIn() && isValidId(mediaId);
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(noticeId);
      allow delete: if isSignedIn() && isValidId(noticeId);
    }

    match /test/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}
